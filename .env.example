# Real Estate MCP Server -- example environment configuration.
# Copy to `.env` and fill in as needed. All integrations are OFF by default.

# --- Server ---
# HOST=127.0.0.1
# PORT=8000
# MCP_TRANSPORT=stdio      # stdio (default) | sse | streamable-http
# LOG_LEVEL=INFO

# --- Feature flags (tool categories) --------------------------------------
# All categories are ON by default. Set any of these to `false` to disable
# an entire tool category (its tools -- and matching resources -- will not
# be registered).
# REALESTATE_MCP_ENABLE_PROPERTY=true
# REALESTATE_MCP_ENABLE_AGENT=true
# REALESTATE_MCP_ENABLE_MARKET=true
# REALESTATE_MCP_ENABLE_CLIENT=true
# REALESTATE_MCP_ENABLE_AREA=true
# REALESTATE_MCP_ENABLE_MORTGAGE=true
# REALESTATE_MCP_ENABLE_VALUATION=true
# REALESTATE_MCP_ENABLE_DOCUMENT=true
# REALESTATE_MCP_ENABLE_ANALYSIS_QUEUE=true   # local SQLite job queue
# REALESTATE_MCP_ENABLE_INTEGRATIONS=true
# REALESTATE_MCP_ENABLE_SYSTEM=true

# --- Census Bureau API (free, preferred for demographics) -----------------
# Free and rate-limited. A key is optional and raises rate limits.
# Request a key at https://api.census.gov/data/key_signup.html
CENSUS_ENABLED=false
CENSUS_API_KEY=
# CENSUS_BASE_URL=https://api.census.gov/data

# --- Walk Score API (free up to 5,000 calls/day) ---------------------------
# Walk/Transit/Bike Score for a location. Free tier requires a free API key.
# Request one at https://www.walkscore.com/professional/api.php
WALKSCORE_ENABLED=false
WALKSCORE_API_KEY=
# WALKSCORE_BASE_URL=https://api.walkscore.com

# --- FEMA National Flood Hazard Layer (free, keyless) ----------------------
# Flood zone lookups by coordinate. No API key required.
FEMA_ENABLED=false
# FEMA_BASE_URL=https://hazards.fema.gov/gis/nfhl/rest/services/public/NFHL/MapServer

# --- FRED economic data (free; mortgage rates, etc.) -----------------------
# Weekly Freddie Mac 30-year mortgage rate (series MORTGAGE30US) and other
# economic indicators. Requires a free API key from
# https://fredaccount.stlouisfed.org/apikeys
FRED_ENABLED=false
FRED_API_KEY=
# FRED_BASE_URL=https://api.stlouisfed.org/fred

# --- FBI Crime Data API (free) ----------------------------------------------
# Federal crime statistics (UCR/NIBRS). Requires a free api.data.gov key
# from https://api.data.gov/signup/
FBI_CRIME_ENABLED=false
FBI_CRIME_API_KEY=
# FBI_CRIME_BASE_URL=https://api.usa.gov/crime/fbi/sapi

# --- EPA Envirofacts (free, keyless) ---------------------------------------
# Environmental hazard data (e.g. Toxics Release Inventory facilities). No
# API key required.
EPA_ENABLED=false
# EPA_BASE_URL=https://data.epa.gov/efservice

# --- NOAA / National Weather Service (free, keyless) ------------------------
# Weather forecasts by coordinate. No API key required, but NWS asks every
# client to identify itself via a User-Agent (app name + contact email).
NOAA_ENABLED=false
# NOAA_CONTACT=real-estate-mcp (you@example.com)
# NOAA_BASE_URL=https://api.weather.gov

# --- RentCast property data API -------------------------------------------
# WARNING: RentCast is a METERED service; requests draw against a monthly
# quota and may incur costs. Leave disabled unless you understand the
# billing implications. Get an API key at https://app.rentcast.io/
RENTCAST_ENABLED=false
RENTCAST_API_KEY=
# RENTCAST_BASE_URL=https://api.rentcast.io/v1

# --- Zillow Group data (paid / enterprise) ----------------------------------
# WARNING: Zillow has no public self-serve API. Live access requires an
# approved data license (e.g. Bridge Interactive, ~$500+/mo) -- see
# https://www.bridgeinteractive.com/developers/zillow-group-data/
# Leave disabled unless you have an approved license and understand the
# billing implications.
ZILLOW_ENABLED=false
ZILLOW_API_KEY=
# ZILLOW_BASE_URL=https://api.bridgedataoutput.com/api/v2/zestimates_v2
